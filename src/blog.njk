---
layout: base.njk
title: Blog
description: All posts by Max.
---

<h1 class="page-title">Blog</h1>

<div class="posts-container">
  {% set posts = collections.posts | reverse %}
  {% if posts.length %}
    {% for post in posts %}
    <article class="post-card">
      <div class="post-card-content">
        {% if post.data.image %}
        <a href="{{ post.url }}" class="story-thumb-link">
          <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="story-thumb">
        </a>
        {% endif %}
        <div class="post-body">
          <div class="post-meta"><time>{{ post.date | dateDisplay }}</time></div>
          <h2 class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <p class="post-excerpt">{{ post.data.description }}</p>
          {% if post.data.postTags %}
          <div class="post-tags">
            {% for t in post.data.postTags %}
            <a href="/tags/{{ t }}/" class="tag-chip">{{ t }}</a>
            {% endfor %}
          </div>
          {% endif %}
          <a class="read-more" href="{{ post.url }}">read more →</a>
        </div>
      </div>
    </article>
    {% endfor %}
  {% else %}
    <p style="color:var(--muted)">Nothing yet. Check back soon.</p>
  {% endif %}
</div>

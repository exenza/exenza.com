<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Max</title>
  <meta name="description" content="{{ description }}">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap">
</head>
<body>
  <div id="page-bg" style="background-image: url('{{ image }}')"></div>
  <header>
    <nav>
      <a href="/" class="logo">
        eXenZa
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/stories/">Stories</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
      </div>
    </nav>
  </header>
  <main>
    <div class="post-single">
      {% if image %}
      <div class="story-hero-image">
        <img src="{{ image }}" alt="{{ title }}">
      </div>
      {% endif %}
      <div class="post-header">
        <h1>{{ title }}</h1>
        <div class="post-meta">
          <time>{{ date | dateDisplay }}</time>
          {% if storyType %}<span class="tag-chip">{{ storyType }}</span>{% endif %}
        </div>
      </div>
      <div class="post-content">
        {{ content | safe }}
      </div>
      <div class="post-footer">
        <a href="/stories/">← stories</a>
      </div>
    </div>
  </main>
  <footer>
    <p>Max · <a href="https://exenza.com">exenza.com</a></p>
  </footer>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Max</title>
  <meta name="description" content="{{ description or 'Max — writing short stories and poems.' }}">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap">
</head>
<body>
  <div id="page-bg"></div>
  <script>
    (function() {
      var imgs = [
        '/assets/img/stories/red-laced.jpg',
        '/assets/img/stories/chasing-happiness.jpg',
        '/assets/img/stories/a-blessing-a-curse.webp',
        '/assets/img/stories/gerald-fog.jpg',
        '/assets/img/stories/the-baker.jpg',
        '/assets/img/stories/a-conversation-with-oscar.jpg',
        '/assets/img/stories/the-julian-case.jpg',
        '/assets/img/stories/random.jpg',
        '/assets/img/stories/ero.jpg',
        '/assets/img/stories/always-right.jpg',
        '/assets/img/stories/friends.jpg',
        '/assets/img/stories/lazy-writer.jpg',
        '/assets/img/stories/ei.jpg',
        '/assets/img/stories/circus.jpg',
        '/assets/img/stories/particelle.jpg'
      ];
      var url = imgs[Math.floor(Math.random() * imgs.length)];
      document.getElementById('page-bg').style.backgroundImage = 'url("' + url + '")';
    })();
  </script>
  <header>
    <nav>
      <a href="/" class="logo">
        eXenZa
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/stories/">Stories</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
      </div>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>Max · <a href="https://exenza.com">exenza.com</a></p>
  </footer>
</body>
</html>

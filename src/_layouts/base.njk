<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Max</title>
  <meta name="description" content="{{ description or 'Max — writing short stories and poems.' }}">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap">
</head>
<body>
  <div id="page-bg"></div>
  <script>
    (function() {
      var imgs = [{% for story in collections.stories %}{% if story.data.image %}'{{ story.data.image }}',{% endif %}{% endfor %}{% for post in collections.posts %}{% if post.data.image %}'{{ post.data.image }}',{% endif %}{% endfor %}];
      if (!imgs.length) return;
      var url = imgs[Math.floor(Math.random() * imgs.length)];
      document.getElementById('page-bg').style.backgroundImage = 'url("' + url + '")';
    })();
  </script>
  <header>
    <nav>
      <a href="/" class="logo">
        eXenZa
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/stories/">Stories</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
      </div>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>Max · <a href="https://exenza.com">exenza.com</a></p>
  </footer>
</body>
</html>

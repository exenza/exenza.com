---
title: eXenZa
description: Writing short stories and poems, the human behind neo.exenza.com
layout: base.njk
---

<div class="hero">
  <div class="hero-content">
    <h1>Max</h1>
    <p>Writing short stories and poems.</p>
  </div>
</div>

<div class="content-wrapper">
  <div class="posts-container">
    {% set posts = collections.posts | reverse %}
    {% if posts.length %}
      {% for post in posts %}
      {% if loop.index <= 10 %}
      <article class="post-card">
        <div class="post-card-content">
          <div class="post-body">
            <div class="post-meta"><time>{{ post.date | dateDisplay }}</time></div>
            <h2 class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p class="post-excerpt">{{ post.data.description }}</p>
            {% if post.data.postTags %}
            <div class="post-tags">
              {% for t in post.data.postTags %}
              <a href="/tags/{{ t }}/" class="tag-chip">{{ t }}</a>
              {% endfor %}
            </div>
            {% endif %}
            <a class="read-more" href="{{ post.url }}">read more →</a>
          </div>
        </div>
      </article>
      {% endif %}
      {% endfor %}
    {% else %}
      <p style="color:var(--muted)">First post coming soon.</p>
    {% endif %}
  </div>

  <aside class="sidebar">
    <div class="sidebar-card">
      <h3>About Max</h3>
      <p>Writer based in South London. Short stories, poems, and occasional dispatches from a life lived at full speed.</p>
    </div>
    <div class="sidebar-card">
      <h3>Topics</h3>
      <ul class="topics-list">
        {% for tag in collections.postTagList %}
        <li><a href="/tags/{{ tag }}/">{{ tag }}</a></li>
        {% endfor %}
        {% for type in collections.storyTypeList %}
        <li><a href="/stories/#{{ type | replace(' ', '-') }}">{{ type }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </aside>
</div>

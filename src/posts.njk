---
layout: base.njk
title: Posts
description: All posts by Neo.
---

<h1>Posts</h1>

{% set posts = collections.posts | reverse %}
{% if posts.length %}
<ul class="post-list">
  {% for post in posts %}
  <li>
    <div class="post-meta">{{ post.date | dateDisplay }}</div>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="post-excerpt">{{ post.data.description or (post.templateContent | excerpt) }}</p>
    <a class="read-more" href="{{ post.url }}">Read →</a>
  </li>
  {% endfor %}
</ul>
{% else %}
<p style="color: var(--muted)">Nothing yet. Check back soon.</p>
{% endif %}
